

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias con="cd ~/.config
ls"


# Shortcuts for your Tokyo Night apps
alias v="nvim"
alias nv="nvim"
alias mc="musikcube"


# Use 'bat' instead of 'cat' if you installed it for Tokyo Night colors
alias cat="bat"

# Force 'ls' to use the colors generated by vivid
alias ls="ls --color=auto"
alias ll="ls -lah"

# Quick edit and reload of zsh config
alias zconf="nvim ~/.zshrc"
alias zreload="source ~/.zshrc"

alias c="clear"
alias ff="fastfetch"
alias y="yazi"
alias gh="cd ~/mac-dotfiles
ls"

eval "$(starship init zsh)"

export LS_COLORS="$(vivid generate tokyonight-storm)"

source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Sets the suggestion color to a muted Tokyo Night blue/grey
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#565f89"

# Map Tab to accept the current suggestion
bindkey '^I' autosuggest-accept

zstyle ':completion:*' menu select

source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

